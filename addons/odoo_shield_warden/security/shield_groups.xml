<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_shield" model="ir.module.category">
        <field name="name">Security &amp; GRC</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_shield_user" model="res.groups">
        <field name="name">Viewer</field>
        <field name="category_id" ref="module_category_shield"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can read assessments, findings and the risk register.</field>
    </record>

    <record id="group_shield_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_shield"/>
        <field name="implied_ids" eval="[(4, ref('group_shield_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Runs assessments, owns findings, accepts risks and records attestations.</field>
    </record>
</odoo>
