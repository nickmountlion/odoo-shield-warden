<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shield_framework_list" model="ir.ui.view">
        <field name="name">shield.framework.list</field>
        <field name="model">shield.framework</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="name"/>
                <field name="code"/>
                <field name="version"/>
            </list>
        </field>
    </record>

    <record id="view_shield_framework_form" model="ir.ui.view">
        <field name="name">shield.framework.form</field>
        <field name="model">shield.framework</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="code"/>
                        <field name="version"/>
                    </group>
                    <field name="requirement_ids">
                        <list>
                            <field name="ref"/>
                            <field name="name"/>
                            <field name="control_ids" widget="many2many_tags"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shield_frameworks" model="ir.actions.act_window">
        <field name="name">Frameworks</field>
        <field name="res_model">shield.framework</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
