<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shield_risk_case_kanban" model="ir.ui.view">
        <field name="name">shield.risk.case.kanban</field>
        <field name="model">shield.risk.case</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" create="false" group_create="false" records_draggable="false">
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="name" class="fw-bold"/>
                            <field name="severity" widget="badge" decoration-danger="severity in ('critical', 'high')"
                                   decoration-warning="severity == 'medium'"/>
                        </div>
                        <field name="amount" widget="monetary" class="fs-4 fw-bold text-danger"/>
                        <div class="small text-muted"><field name="alert_count"/> alert(s)</div>
                        <field name="actor_ids" widget="many2many_avatar_user"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_shield_risk_case_list" model="ir.ui.view">
        <field name="name">shield.risk.case.list</field>
        <field name="model">shield.risk.case</field>
        <field name="arch" type="xml">
            <list create="false" decoration-muted="state in ('legitimate', 'closed')" decoration-danger="state == 'escalated'">
                <field name="severity" widget="badge" decoration-danger="severity in ('critical', 'high')"
                       decoration-warning="severity == 'medium'"/>
                <field name="name"/>
                <field name="alert_count"/>
                <field name="actor_ids" widget="many2many_avatar_user"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount" sum="Total at risk"/>
                <field name="state" widget="badge" decoration-danger="state == 'escalated'"
                       decoration-warning="state == 'open'" decoration-success="state == 'legitimate'"/>
            </list>
        </field>
    </record>

    <record id="view_shield_risk_case_form" model="ir.ui.view">
        <field name="name">shield.risk.case.form</field>
        <field name="model">shield.risk.case</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_mark_legitimate" type="object" string="Verified legitimate" class="btn-primary"
                            invisible="state not in ('open', 'escalated')" groups="odoo_shield_warden.group_shield_manager"/>
                    <button name="action_escalate" type="object" string="Escalate"
                            invisible="state != 'open'" groups="odoo_shield_warden.group_shield_manager"/>
                    <button name="action_reopen" type="object" string="Reopen"
                            invisible="state == 'open'" groups="odoo_shield_warden.group_shield_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,escalated,legitimate"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h2><field name="name"/></h2>
                        <h1 class="text-danger"><field name="amount"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="severity"/>
                            <field name="partner_id"/>
                            <field name="bank_id" invisible="not bank_id"/>
                        </group>
                        <group>
                            <field name="actor_ids" widget="many2many_avatar_user"/>
                            <field name="reviewer_id" invisible="not reviewer_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <label for="reasons" string="Why Shield opened this case"/>
                    <field name="reasons"/>
                    <label for="review_note"/>
                    <field name="review_note" placeholder="How was it verified? e.g. 'Called vendor CFO on the number in our 2024 contract; change confirmed.'"/>
                    <notebook>
                        <page string="Alerts">
                            <field name="event_ids">
                                <list>
                                    <field name="severity"/>
                                    <field name="rule"/>
                                    <field name="detail"/>
                                    <field name="actor_id" widget="many2one_avatar_user"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="amount"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_shield_risk_case_search" model="ir.ui.view">
        <field name="name">shield.risk.case.search</field>
        <field name="model">shield.risk.case</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="actor_ids"/>
                <filter name="to_review" string="To review" domain="[('state', 'in', ('open', 'escalated'))]"/>
                <filter name="critical_high" string="Critical &amp; high" domain="[('severity', 'in', ('critical', 'high'))]"/>
            </search>
        </field>
    </record>

    <record id="action_shield_risk_cases" model="ir.actions.act_window">
        <field name="name">Money at Risk</field>
        <field name="res_model">shield.risk.case</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_to_review': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No money at risk</p>
            <p>Each case groups every alert about one bank account, payment or bill, with the money counted once.</p>
        </field>
    </record>

    <!-- Payment hold on the bank account form -->
    <record id="view_partner_bank_form_shield" model="ir.ui.view">
        <field name="name">res.partner.bank.form.shield</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_shield_verify" type="object" string="Verify with Shield" class="btn-primary"
                            invisible="not shield_hold_reason"
                            confirm="Confirm you verified this account number with the vendor through a channel you already trusted (e.g. a phone number from an existing contract)."/>
                </header>
            </xpath>
            <xpath expr="//sheet/group" position="before">
                <div class="alert alert-warning" role="alert" invisible="not shield_hold_reason">
                    <strong>Payments held by Shield:</strong> <field name="shield_hold_reason" class="oe_inline"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='allow_out_payment']" position="after">
                <field name="shield_verified_by" invisible="not shield_verified_by"/>
                <field name="shield_verified_on" invisible="not shield_verified_on"/>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_shield_money_at_risk" name="Money at Risk" parent="odoo_shield_warden.menu_shield_root"
              action="action_shield_risk_cases" sequence="5"/>
    <menuitem id="menu_shield_alerts" name="Alerts" parent="odoo_shield_warden.menu_shield_grc"
              action="action_shield_risk_events" sequence="0"/>
</odoo>
